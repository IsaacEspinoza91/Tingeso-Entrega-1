pipeline {
    agent any
    
    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-credentials')
        BACKEND_DOCKER_IMAGE = 'isaaccumbia/karting-backend:latest'
    }
    
    stages {
        stage('Obtener código') {
            steps {
                checkout scm
            }
        }
        
        stage('Construir Backend') {
            steps {
                dir('AppKartingRM') {
                    bat 'gradlew.bat clean build'
                }
            }
        }
        
        stage('Ejecutar Pruebas Backend') {
            steps {
                dir('AppKartingRM') {
                    bat 'gradlew.bat test'
                }
            }
            
            post {
                always {
                    junit 'AppKartingRM/build/test-results/test/*.xml'
                    archiveArtifacts artifacts: 'AppKartingRM/build/reports/tests/test/**/*', allowEmptyArchive: true
                }
            }
        }
        
    }
}