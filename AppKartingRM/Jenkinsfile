pipeline {
    agent any
    
    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-credentials')
        BACKEND_DOCKER_IMAGE = 'isaaccumbia/karting-backend'
    }
    
    stages {
        stage('Obtener código') {
            steps {
                checkout scm
            }
        }
        
        stage('Construir Backend') {
            steps {
                dir('AppKartingRM') {
                    bat 'gradlew.bat clean build'
                }
            }
        }
        
        stage('Ejecutar Pruebas Backend') {
            steps {
                dir('AppKartingRM') {
                    bat 'gradlew.bat test --tests "com.kartingRM.AppKartingRM.services.*"'
                }
            }
        }
        
        stage('Construir Imagen Docker Backend') {
            steps {
                dir('AppKartingRM') {
                    script {
                        // Construir imagen latest
                        bat "docker build --build-arg JAR_FILE=build/libs/*.jar -t ${BACKEND_DOCKER_IMAGE}:latest ."
                    }
                }
            }
        }

        stage('Subir a Docker') {
            steps {
                script {
                    bat "docker login -u ${DOCKER_HUB_CREDENTIALS_USR} -p ${DOCKER_HUB_CREDENTIALS_PSW}"
                    bat "docker push ${BACKEND_DOCKER_IMAGE}:latest"
                }
            }
        }
    }
}