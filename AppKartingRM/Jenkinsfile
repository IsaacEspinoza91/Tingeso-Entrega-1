pipeline {
    agent any
    
    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-credentials')
        BACKEND_DOCKER_IMAGE = 'isaaccumbia/karting-backend:latest'
    }
    
    stages {
        stage('Obtener código') {
            steps {
                checkout scm
            }
        }
        
        stage('Construir Backend') {
            steps {
                dir('AppKartingRM') {
                    sh './gradlew clean build'
                }
            }
        }
        
        stage('Ejecutar Pruebas Backend') {
            steps {
                dir('AppKartingRM') {
                    // Ejecutar todos los tests
                    sh './gradlew test'
                    
                    // Opcional: si quieres ejecutar tests específicos
                    // sh './gradlew test --tests "com.kartingRM.AppKartingRM.services.*"'
                }
            }
            
            post {
                always {
                    junit 'AppKartingRM/build/test-results/test/*.xml' // Archivar resultados de pruebas JUnit
                }
            }
        }

    }
    

}